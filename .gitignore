# ============================================================
# MineGuard .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
.venv-verify/

# ---- Test / tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---- Runtime output ----
logs/
*.log

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ---- Arduino / PlatformIO ----
.pio/
.pioenvs/
.piolibdeps/
*.bin
*.elf
*.hex

# ---- Secrets / local config ----
.env
.env.*
!.env.example
